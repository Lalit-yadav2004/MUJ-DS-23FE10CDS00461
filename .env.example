# ==============================================================================
# CodePulse AI - Environment Variables
# ==============================================================================
# Copy this file to .env and insert your API key:
# cp .env.example .env
#
# Get your free Google Gemini API key at:
# https://aistudio.google.com/app/apikey
# ==============================================================================

GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Default provider ('gemini' or 'mock' for offline testing)
CODEPULSE_PROVIDER=gemini

# Optional: Web UI Host & Port
PORT=8000
HOST=127.0.0.1
